# Copy to .env and fill in. Never commit .env.
# Every value here is a placeholder — none of these are real secrets.

# --- Required -------------------------------------------------------------

# No default. Gates the OTP stub, the dashboard token, and the API docs, so a
# missing value must fail startup rather than quietly meaning "development".
# One of: development | test | production
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://mealsonwheels:localdev@localhost:5432/highway_food_booking

# HS256 signing secret, 32+ bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses to boot in production if this is short or left as the placeholder.
JWT_SECRET=change-me-this-is-a-development-placeholder-value

# Shared secret for the X-Restaurant-Token dashboard header.
# Required when ENVIRONMENT != production; refused outright in production.
RESTAURANT_DASHBOARD_TOKEN=dev-restaurant-token

# --- Optional -------------------------------------------------------------

# Omit entirely to run without a cache. The app degrades, it does not fail.
REDIS_URL=redis://localhost:6379/0

JWT_EXPIRE_HOURS=24

# Comma-separated. Never "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MealsOnWheels/1.0 (+https://github.com/nithishkumar2022020/MealsOnWheels)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Email notifications (optional) ---------------------------------------
# Unset: notifications are logged instead of sent.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@mealsonwheels.example
